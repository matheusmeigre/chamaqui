DATABASE_URL="EXAMPLE"
DIRECT_URL="EXAMPLE"

# Autenticação por dispositivo (JWT + refresh token criptografado)
AUTH_TOKEN_SECRET="EXAMPLE"               # ≥16 chars; assina access e device tokens
TOKEN_ENCRYPTION_KEY="EXAMPLE"            # 32 bytes hex (prefixo "hex:"); encripta refresh tokens
AUTH_FINGERPRINT_SECRET="EXAMPLE"         # ≥16 chars; HMAC do fingerprint do dispositivo

# Segredos legados (mantidos por compatibilidade; prefira AUTH_TOKEN_SECRET)
NEXTAUTH_SECRET="EXAMPLE"
AUTH_RATE_LIMIT_SECRET="EXAMPLE"
INSTITUTO_ENERGISA_ACCESS_KEY="EXAMPLE"
HDL_ACCESS_KEY="EXAMPLE"

# Chaves de acesso das organizações (bootstrap): <SLUG> = slug da organização.
# Convenção: ORG_ACCESS_KEY_<SLUG com traços virados em underscore e maiúsculo>
ORG_ACCESS_KEY_HDL="EXAMPLE"
ORG_ACCESS_KEY_INSTITUTO_ENERGISA="EXAMPLE"

NEXT_PUBLIC_SUPABASE_URL="EXAMPLE"
NEXT_PUBLIC_SUPABASE_ANON_KEY="EXAMPLE"
NEXTAUTH_URL="http://localhost:3000"
