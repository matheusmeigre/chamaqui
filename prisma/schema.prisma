// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// 1. ENUMS (Classificações e Ciclo de Vida)
// ----------------------------------------------------------------------------

enum Role {
  SOLICITANTE
  ADMINISTRADOR
}

enum TicketStatus {
  ABERTO
  EM_TRIAGEM
  EM_ATENDIMENTO
  PENDENTE
  RESOLVIDO
  FECHADO
  CANCELADO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum DeviceStatus {
  ATIVO
  REVOGADO
}

// --- Grade de Chamados -------------------------------------------------------

/// Eixo natureza: define quem paga e o que tem teto.
enum TicketCategoryCode {
  C1 // Incidente / correção — garantia, sem teto
  C2 // Operação de conteúdo — teto por item
  C3 // Suporte — teto por atendimento
  C4 // Ajuste evolutivo — teto por chamado, até 8 h
  C5 // Evolutivo estruturante — fora do contrato
  C6 // Plataforma — teto por evento
}

/// Eixo severidade: define SLA. Aplicável somente a C1, e nunca tem teto.
enum Severity {
  P1
  P2
  P3
  P4
}

/// Unidade em que o teto de cada categoria é contado.
enum QuotaUnit {
  CHAMADO
  ITEM
  ATENDIMENTO
  EVENTO
  PROJETO
}

enum TicketChannel {
  PORTAL
  EMAIL
  TELEFONE
  PRESENCIAL
  OUTRO
}

/// Correção no servidor é instantânea; no cliente exige publicação na Play.
enum CorrectionClass {
  SERVIDOR
  CLIENTE
}

enum TicketOutcome {
  RESOLVIDO
  IMPROCEDENTE_NAO_REPRODUZ
  IMPROCEDENTE_ERRO_USO
  IMPROCEDENTE_TERCEIRO
  DUPLICADO
  RECLASSIFICADO
}

enum ContractTier {
  ESSENCIAL
  PADRAO
  AMPLIADO
}

enum ContestationDecision {
  MANTIDA
  ALTERADA
  EXPIRADA
}

/// No estouro do teto a escolha é do cliente, chamado a chamado.
enum OverrunDecision {
  EXCEDENTE
  FILA_PROXIMO_MES
}

enum QuotaAdjustmentType {
  ANTECIPACAO
  ZERAMENTO_RAJADA
  MANUAL
}

enum HolidayScope {
  NACIONAL
  ESTADUAL
  MUNICIPAL
}

// ----------------------------------------------------------------------------
// 2. MODELS
// ----------------------------------------------------------------------------

model Organization {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  email      String   @unique // Identidade canônica do usuário da organização
  enabled    Boolean  @default(true)

  // Relações
  users           User[]
  devices         Device[]
  activationCodes ActivationCode[]
  auditLogs       AuditLog[]
  contract        SupportContract?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  role          Role      @default(SOLICITANTE)

  // Relações
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  devices        Device[]
  createdTickets Ticket[]   @relation("Solicitante")
  assignedTickets Ticket[]  @relation("Atendente")
  comments       Comment[]
  notifications  Notification[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AuthThrottle {
  organization   String
  clientHash     String
  failedAttempts Int       @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil   DateTime?
  updatedAt      DateTime  @updatedAt

  @@id([organization, clientHash])
  @@index([updatedAt])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  
  // SLA em horas úteis padrão para esta categoria
  defaultSlaHours Int     @default(24)

  tickets     Ticket[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Ticket {
  id          String        @id @default(uuid())
  title       String
  description String        @db.Text
  status      TicketStatus  @default(ABERTO)
  priority    Priority      @default(BAIXA)
  
  // Controle de SLA
  slaTarget   DateTime?
  resolvedAt  DateTime?

  // Relações
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  
  requesterId String
  requester   User          @relation("Solicitante", fields: [requesterId], references: [id])
  
  assigneeId  String?
  assignee    User?         @relation("Atendente", fields: [assigneeId], references: [id])

  comments    Comment[]

  // Avaliação do cliente (1 a 5)
  rating      Int?
  ratingNotes String?       @db.Text

  // Anexos do chamado
  attachmentUrls String[]

  // --------------------------------------------------------------------------
  // Grade de Chamados
  // --------------------------------------------------------------------------

  /// Eixo natureza. Nullable apenas para os chamados anteriores à grade.
  categoryCode TicketCategoryCode?
  /// Eixo severidade. Preenchido se e somente se categoryCode = C1.
  severity     Severity?
  channel      TicketChannel      @default(PORTAL)

  /// Marco zero do SLA. Para chamado aberto fora do canal oficial, é a data de
  /// registro no sistema — não a da mensagem avulsa.
  openedAt           DateTime  @default(now())
  firstResponseAt    DateTime?
  workaroundAt       DateTime?
  definitiveFixAt    DateTime?

  /// Define se a janela de revisão da loja é descontada do relógio de SLA.
  correctionClass CorrectionClass?
  sentToStoreAt   DateTime?
  storeApprovedAt DateTime?

  /// Unidades consumidas do teto: itens de C2, atendimentos de C3, eventos de C6.
  units          Int    @default(1)
  estimatedHours Float?
  actualHours    Float?

  /// Marcos da triagem. A etapa acontece uma única vez por chamado: depois de
  /// concluída, o chamado não pode voltar para EM_TRIAGEM.
  triageEnteredAt   DateTime?
  triageCompletedAt DateTime?

  outcome       TicketOutcome?
  /// Derivado: false para todo desfecho improcedente, duplicado ou reabertura.
  consumesQuota Boolean        @default(true)
  /// Mês de apuração do teto, no formato YYYY-MM.
  competency    String?

  /// Reabertura e agrupamento: aponta para o chamado original.
  parentTicketId String?
  parentTicket   Ticket?  @relation("ReaberturaChamado", fields: [parentTicketId], references: [id], onDelete: SetNull)
  childTickets   Ticket[] @relation("ReaberturaChamado")

  // Contestação da categoria pelo cliente (5 dias úteis)
  contestationOpenedAt  DateTime?
  contestationDeadline  DateTime?
  contestationReason    String?               @db.Text
  contestationDecision  ContestationDecision?
  contestationDecidedAt DateTime?

  // Excedente: no estouro do teto, a execução fica bloqueada até a escolha
  executionBlocked Boolean          @default(false)
  overrunDecision  OverrunDecision?
  overrunDecidedAt DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryCode, competency])
  @@index([severity, openedAt])
  @@index([parentTicketId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  
  isSystem  Boolean  @default(false) // Para diferenciar comentários humanos de logs do sistema (ex: "Status alterado para Resolvido")
  attachmentUrls String[] // Anexos nos comentários
  
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  link      String?  
  read      Boolean  @default(false)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// 3. AUTENTICAÇÃO POR DISPOSITIVO
// ----------------------------------------------------------------------------

model Device {
  id             String       @id @default(uuid())
  name           String       // Ex: "Notebook do João"
  fingerprintHash String      // Hash do fingerprint do navegador/dispositivo (device binding)
  platform       String?      // Ex: "Windows", "Android", "iOS"
  browser        String?      // Ex: "Chrome", "Safari"
  lastIp         String?
  lastSeenAt     DateTime?
  status         DeviceStatus @default(ATIVO)
  revokedAt      DateTime?

  // Relações
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model ActivationCode {
  id             String   @id @default(uuid())
  codeHash       String   @unique // Armazenamos apenas o hash do código curto
  role           Role     @default(SOLICITANTE) // Permissão concedida pela ativação
  expiresAt      DateTime
  usedAt         DateTime?
  usedByDeviceId String?

  // Relações
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([expiresAt])
}

model RefreshToken {
  id             String   @id @default(uuid())
  tokenHash      String   @unique   // SHA-256 do token (nunca armazenamos texto puro)
  tokenEncrypted String   @db.Text  // Valor criptografado (AES-256-GCM)
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?  // Rotação: novo token que substituiu este

  // Relações
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([expiresAt])
}

model AuditLog {
  id       String @id @default(uuid())
  action   String // Ex: "DEVICE_ACTIVATED", "DEVICE_REVOKED", "LOGIN", "LOGOUT", "CODE_GENERATED"

  // Relações (opcionais para preservar o registro mesmo se o recurso for removido)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  deviceId       String?
  device         Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// 4. GRADE DE CHAMADOS — CONTRATO, TETOS E CALENDÁRIO
// ----------------------------------------------------------------------------

/// Contrato de sustentação de uma organização. A faixa define capacidade,
/// reservas de C1/P1 e os tetos mensais por categoria.
model SupportContract {
  id            String       @id @default(uuid())
  tier          ContractTier @default(PADRAO)
  /// Capacidade contratada em horas/mês. Redundante com a faixa, mas
  /// persistida para preservar o histórico se a grade for recalibrada.
  capacityHours Int
  active        Boolean      @default(true)
  startsAt      DateTime     @default(now())
  endsAt        DateTime?

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  quotaOverrides ContractQuota[]
  adjustments    QuotaAdjustment[]
  alerts         QuotaAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/// Teto negociado que sobrepõe o valor padrão da faixa para uma categoria.
/// Ausência de registro significa "usar o teto da faixa".
model ContractQuota {
  id           String             @id @default(uuid())
  categoryCode TicketCategoryCode
  unit         QuotaUnit
  /// null = sem teto para esta categoria neste contrato.
  monthlyLimit Int?

  contractId String
  contract   SupportContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, categoryCode])
}

/// Ajustes pontuais do teto de uma competência: antecipação de até 20% do mês
/// seguinte, zeramento por rajada de P1, ou ajuste manual acordado.
model QuotaAdjustment {
  id           String              @id @default(uuid())
  competency   String
  categoryCode TicketCategoryCode
  type         QuotaAdjustmentType
  /// Delta em unidades aplicado ao teto da competência (pode ser negativo).
  amount       Int
  reason       String?             @db.Text

  contractId String
  contract   SupportContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdById String?
  createdAt   DateTime @default(now())

  @@index([contractId, competency])
}

/// Registro idempotente dos avisos de 80% e 100% do teto, para não notificar
/// o mesmo limiar duas vezes na mesma competência.
model QuotaAlert {
  id           String             @id @default(uuid())
  competency   String
  categoryCode TicketCategoryCode
  /// Limiar atingido, em pontos percentuais (80 ou 100).
  threshold    Int

  contractId String
  contract   SupportContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([contractId, competency, categoryCode, threshold])
}

/// Calendário de feriados usado pelo relógio de SLA em horas úteis.
model Holiday {
  id           String       @id @default(uuid())
  date         DateTime     @db.Date
  name         String
  scope        HolidayScope
  /// Preenchido quando scope = MUNICIPAL.
  municipality String?

  createdAt DateTime @default(now())

  @@unique([date, name])
  @@index([date])
}
