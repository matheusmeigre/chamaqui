// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// 1. ENUMS (Classificações e Ciclo de Vida)
// ----------------------------------------------------------------------------

enum Role {
  SOLICITANTE
  ATENDENTE
  ADMINISTRADOR
}

enum TicketStatus {
  ABERTO
  EM_TRIAGEM
  EM_ATENDIMENTO
  PENDENTE
  RESOLVIDO
  FECHADO
  CANCELADO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum DeviceStatus {
  ATIVO
  REVOGADO
}

// ----------------------------------------------------------------------------
// 2. MODELS
// ----------------------------------------------------------------------------

model Organization {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  email      String   @unique // Identidade canônica do usuário da organização
  enabled    Boolean  @default(true)

  // Relações
  users           User[]
  devices         Device[]
  activationCodes ActivationCode[]
  auditLogs       AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  role          Role      @default(SOLICITANTE)

  // Relações
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  devices        Device[]
  createdTickets Ticket[]   @relation("Solicitante")
  assignedTickets Ticket[]  @relation("Atendente")
  comments       Comment[]
  notifications  Notification[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AuthThrottle {
  organization   String
  clientHash     String
  failedAttempts Int       @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil   DateTime?
  updatedAt      DateTime  @updatedAt

  @@id([organization, clientHash])
  @@index([updatedAt])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  
  // SLA em horas úteis padrão para esta categoria
  defaultSlaHours Int     @default(24)

  tickets     Ticket[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Ticket {
  id          String        @id @default(uuid())
  title       String
  description String        @db.Text
  status      TicketStatus  @default(ABERTO)
  priority    Priority      @default(BAIXA)
  
  // Controle de SLA
  slaTarget   DateTime?
  resolvedAt  DateTime?

  // Relações
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  
  requesterId String
  requester   User          @relation("Solicitante", fields: [requesterId], references: [id])
  
  assigneeId  String?
  assignee    User?         @relation("Atendente", fields: [assigneeId], references: [id])

  comments    Comment[]

  // Avaliação do cliente (1 a 5)
  rating      Int?
  ratingNotes String?       @db.Text

  // Anexos do chamado
  attachmentUrls String[]
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  
  isSystem  Boolean  @default(false) // Para diferenciar comentários humanos de logs do sistema (ex: "Status alterado para Resolvido")
  attachmentUrls String[] // Anexos nos comentários
  
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  link      String?  
  read      Boolean  @default(false)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// 3. AUTENTICAÇÃO POR DISPOSITIVO
// ----------------------------------------------------------------------------

model Device {
  id             String       @id @default(uuid())
  name           String       // Ex: "Notebook do João"
  fingerprintHash String      // Hash do fingerprint do navegador/dispositivo (device binding)
  platform       String?      // Ex: "Windows", "Android", "iOS"
  browser        String?      // Ex: "Chrome", "Safari"
  lastIp         String?
  lastSeenAt     DateTime?
  status         DeviceStatus @default(ATIVO)
  revokedAt      DateTime?

  // Relações
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model ActivationCode {
  id             String   @id @default(uuid())
  codeHash       String   @unique // Armazenamos apenas o hash do código curto
  role           Role     @default(SOLICITANTE) // Permissão concedida pela ativação
  expiresAt      DateTime
  usedAt         DateTime?
  usedByDeviceId String?

  // Relações
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([expiresAt])
}

model RefreshToken {
  id             String   @id @default(uuid())
  tokenHash      String   @unique   // SHA-256 do token (nunca armazenamos texto puro)
  tokenEncrypted String   @db.Text  // Valor criptografado (AES-256-GCM)
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?  // Rotação: novo token que substituiu este

  // Relações
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([expiresAt])
}

model AuditLog {
  id       String @id @default(uuid())
  action   String // Ex: "DEVICE_ACTIVATED", "DEVICE_REVOKED", "LOGIN", "LOGOUT", "CODE_GENERATED"

  // Relações (opcionais para preservar o registro mesmo se o recurso for removido)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  deviceId       String?
  device         Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([organizationId])
  @@index([createdAt])
}
